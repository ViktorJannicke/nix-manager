{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["./ui/lib"],
      "$lib/*": ["./ui/lib/*"]
    }
  },
  "include": ["ui/**/*.ts", "ui/**/*.svelte", "src/domain.ts", "src/contracts.ts"]
}
