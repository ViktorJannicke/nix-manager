<!-- The Nix build publishes the application with NativeAOT (PublishAot for NixManager.csproj alone); the tests run
     under the JIT with their own lock files. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <!-- As in NixManager.csproj: a lock file per runtime for the Nix build. -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifiers)' == 'linux-arm64'">packages.linux-arm64.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.73.19" />
    <PackageReference Include="Runic.Application.Testing" Version="0.8.0-preview.6" />
    <PackageReference Include="Runic.CommandLine.Testing" Version="0.7.0-preview.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests need the application's assembly, not its built frontend. -->
    <ProjectReference Include="../NixManager.csproj" AdditionalProperties="RunicApplicationFrontendBuildEnabled=false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recorded outputs and fixtures, and the Nix error fixtures under test/fixtures/nix-errors. -->
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../test/fixtures/nix-errors/*.txt" Link="Fixtures/nix-errors/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The dashboard's curated features and Computer page settings, which name the options the inventory reads. -->
    <None Include="../Frontend/src/lib/curated.ts;../Frontend/src/lib/computer.ts" Link="Fixtures/frontend/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
