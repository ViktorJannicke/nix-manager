bundle {
  item_pending =
    .input {$count :integer}
    .match $count
    one {{{$title}: {$count} item pending}}
    * {{{$title}: {$count} items pending}}
  include = Include {$name}
  untick_what_you_do_not_want = Untick what you do not want; everything else becomes one pending edit.
  the_package_index_could_not_be = The package index could not be built. {$error}
  reading_the_package_index = Reading the package index…
  features = Features
  apps_installed_for_you = Apps, installed for you
  pending = Pending
  is_not_free_software_allowing_non =
    .input {$count :integer}
    .input {$names :runic:list}
    .match $count
    one {{{$names} is not free software; allowing non-free software is part of the edit.}}
    * {{{$names} are not free software; allowing non-free software is part of the edit.}}
  needs_a_file_chosen_by_hand =
    .input {$count :integer}
    .input {$names :runic:list}
    .match $count
    one {{{$names} needs a file chosen by hand. Add it from Discover on its own.}}
    * {{{$names} need a file chosen by hand. Add them from Discover on their own.}}
  add_item_to_pending_edits =
    .input {$count :integer}
    .match $count
    one {{Add {$count} item to pending edits}}
    * {{Add {$count} items to pending edits}}
  everything_is_there = Everything is there
}

