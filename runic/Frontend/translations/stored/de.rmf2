keep_system_generations_and_collect_garbage = {$count} Wiederherstellungspunkte des Systems behalten und Unbenutztes löschen
collect_unreferenced_store_paths = Nicht mehr benutzte Dateien im Nix-Store löschen
retain_home_generation = Wiederherstellungspunkt {$generation} der Benutzerkonfiguration bereitstellen
retain_system_generation = Wiederherstellungspunkt {$generation} des Systems bereitstellen
stage_the_edited_files = Geänderte Dateien bereitstellen
check_the_edits = Änderungen prüfen
resolve = {$input} auflösen
