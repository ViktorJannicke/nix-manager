resolve_all_flake_inputs = Alle Softwarequellen auflösen
build_home_configuration = Benutzerkonfiguration bauen
build_system_configuration = Systemkonfiguration bauen
compare_with_the_active_configuration = Mit der aktiven Konfiguration vergleichen
write = {$file} schreiben
write_edited_files = {$count} geänderte Dateien schreiben
