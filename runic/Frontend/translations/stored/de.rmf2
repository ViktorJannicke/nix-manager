open_firewall_for_streaming = Firewall fürs Streaming öffnen
needed_for_devices_on_your_network_to = Nötig, damit sich Geräte in Ihrem Netzwerk verbinden können.
start_when_you_log_in = Bei der Anmeldung starten
allow_screen_capture_on_wayland = Bildschirmaufnahme unter Wayland erlauben
required_to_capture_the_screen_in_a = Nötig, um den Bildschirm in einer Plasma-Wayland-Sitzung aufzunehmen.
base_port = Basisport
docker = Docker
build_and_run_containers_with_the_docker = Baut und startet Container mit der Docker-Engine.
start_at_boot = Beim Systemstart starten
when_off_docker_starts_the_first_time = Wenn aus, startet Docker bei der ersten Verwendung.
clean_up_unused_images_automatically = Nicht verwendete Images automatisch aufräumen
