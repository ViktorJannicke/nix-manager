
common {
  list = {$items :runic:list}
  and_more = und {$count :integer} weitere
  cancel = Abbrechen
  close = Schließen
  loading = Wird geladen…
  something_went_wrong = Etwas ist schiefgelaufen
  done = Fertig
  prepare = Vorbereiten
  preparing = Wird vorbereitet…
  undo = Rückgängig
}

nav {
  activity = Aktivität
  not_connected = Das Dashboard konnte keine Verbindung zu Nix Manager herstellen.
  overview = Übersicht
  reading_state = Zustand dieses Computers wird gelesen
  reconnecting = Verbindung wird wiederhergestellt
  restore_points = Wiederherstellungs­punkte
  running = , läuft
  sections = Bereiche
  settings = Einstellungen
  show = Anzeigen
  skip_to_content = Zum Inhalt springen
  targeting = Ziel: {$host}
  updates = Aktualisierungen
  changes = Änderungen
  computer = Computer
  software = Software
}

restart {
  after_operation = Der Neustart wird angeboten, sobald der laufende Vorgang endet.
  failed = Nix Manager konnte nicht neu starten
  ready = Starten Sie Nix Manager neu, um die neue Version zu verwenden. Das Dashboard öffnet sich danach wieder auf dieser Seite.
  now = Jetzt neu starten
  updated = Nix Manager wurde aktualisiert
}

scope {
  all = Ihr Benutzer und das System
  all_text = Ihr Benutzer und das System
  home = Ihr Benutzer
  home_text = Ihr Benutzer
  system = System
  system_text = System
}

status {
  cancelled = Abgebrochen
  done = Fertig
  failed = Fehlgeschlagen
  interrupted = Unterbrochen
  running = Läuft
  skipped = Übersprungen
  waiting = Wartet
}

format {
  seconds = {$seconds} s
  minutes_seconds = {$minutes :integer} min {$seconds :integer} s
  hours_minutes = {$hours :integer} h {$minutes :integer} min
  just_now = gerade eben
  never = nie
  unknown = unbekannt
  less_than_a_minute = weniger als eine Minute
  about_minutes =
    .input {$count :integer}
    .match $count
    one {{etwa {$count} Minute}}
    * {{etwa {$count} Minuten}}
  about_hours =
    .input {$count :number}
    .match $count
    one {{etwa {$count} Stunde}}
    * {{etwa {$count} Stunden}}
  longer_than_usual = Dauert länger als üblich
  time_left = noch {$time}
  unversioned = ohne Version
}

progress {
  built =
    .input {$done :integer}
    .input {$count :integer}
    .match $count
    one {{{$done} von {$count} Paket gebaut}}
    * {{{$done} von {$count} Paketen gebaut}}
  bytes = {$done} von {$expected}
  downloaded = {$done :integer} von {$expected :integer} heruntergeladen
  evaluating = Konfiguration wird ausgewertet…
  failed = {$count :integer} fehlgeschlagen
  label = Build-Fortschritt
  nothing_to_build = Alles ist bereits gebaut
  starting = Wird gestartet…
}

toast {
  cancelled = {$label} abgebrochen
  could_not_cancel = Das Abbrechen ist nicht gelungen
  could_not_refresh = Das Neuladen ist nicht gelungen
  could_not_start = {$action} konnte nicht gestartet werden
  dismiss = Schließen
  error = Fehler:
  failed = Fehlgeschlagen: {$label}
  failed_because = Fehlgeschlagen: {$label} – {$reason}
  finished = {$label} abgeschlossen
  notifications = Benachrichtigungen
  view_log = Protokoll ansehen
  active_after_restart = Das neue System wird nach einem Neustart aktiv.
  allow_non_free = Unfreie Software erlauben
  changes_applied = Änderungen angewendet
  nothing_changed_yet = Auf dem Computer hat sich noch nichts geändert.
  pin_saved = {$label}: Pin gespeichert
  pin_saved_body = Bereiten Sie die Änderungen Ihres Benutzers vor, um die neue Version zu bauen und anzuwenden.
  ready_to_review = Änderungen sind bereit zur Prüfung
  will_apply_on_next_boot = Wird beim nächsten Start angewendet
}

confirm {
  commands = Befehle
  commands_that_will_run = Befehle, die ausgeführt werden
  performed_by_nix_manager = (von Nix Manager ausgeführt)
  starting = Wird gestartet…
}

overview {
  all_activity = Gesamte Aktivität
  configuration = Konfiguration
  nothing_yet = Bisher wurde nichts ausgeführt. Vorbereitete Builds und Aktualisierungen erscheinen hier.
  recent_activity = Letzte Aktivität
  show_output = Ausgabe anzeigen
  step_so_far = {$step}, bisher {$duration}
  this_computer = Dieser Computer
  detached = Losgelöst
  disk_space = Speicherplatz für Software
  disk_used = Belegter Speicherplatz
  edits_cannot_apply =
    .input {$count :integer}
    .match $count
    one {{{$count} Änderung lässt sich auf Ihre Konfiguration in ihrem jetzigen Zustand nicht anwenden.}}
    * {{{$count} Änderungen lassen sich auf Ihre Konfiguration in ihrem jetzigen Zustand nicht anwenden.}}
  everything_saved = Alles ist gespeichert
  free = {$size} frei
  free_space = Speicherplatz durch Entfernen alter Wiederherstellungspunkte freigeben
  last_change = Letzte Änderung, {$when}
  of_total = von {$total}
  pending_edits =
    .input {$count :integer}
    .match $count
    one {{{$count} vorgemerkte Änderung an Ihrer Konfiguration}}
    * {{{$count} vorgemerkte Änderungen an Ihrer Konfiguration}}
  prepare_both = Ihren Benutzer und das System gemeinsam vorbereiten
  reading = Wird gelesen…
  restart_kernel = Das System läuft noch mit Kernel {$booted}; die aktive Konfiguration verwendet {$current}.
  restart_to_finish = Starten Sie neu, um die Aktualisierung abzuschließen.
  show_edits = Änderungen anzeigen
  sources_edited = , Quellversionen bearbeitet
  state = Zustand dieses Computers
  undo_explanation = „Rückgängig“ stellt den Zustand {$what} von vorher wieder her{$files}. Sie sehen, was sich ändert, bevor etwas angewendet wird.
  undo_files_included = , einschließlich der Konfigurationsdateien
  undo_this_computer = dieses Computers
  undo_your_setup = Ihres Benutzers
  unknown = Unbekannt
  unsaved_changes =
    .input {$count :integer}
    .match $count
    one {{{$count} nicht gespeicherte Änderung im Ordner}}
    * {{{$count} nicht gespeicherte Änderungen im Ordner}}
}

activity {
  all = Alle
  applies_on_next_boot = Wird beim nächsten Start angewendet
  details = {$scope} auf {$host}, gestartet {$started}, Dauer {$duration}
  filter = Filter
  finishing = Wird abgeschlossen…
  none_yet = Noch keine Aktivität
  none_yet_body = Vorgänge, die Sie starten, erscheinen hier mit ihren Schritten und ihrer Ausgabe.
  nothing = Nichts anzuzeigen.
  problems = Probleme
  scope_when = {$scope}, {$when}
  steps = Schritte
  try_again = Erneut versuchen
  updates_all_inputs = Aktualisiert alle Flake-Eingaben
  updates_inputs = Aktualisiert {$inputs}
  what_nix_reported = Was Nix gemeldet hat
}

log {
  copied = Protokoll kopiert
  copy = Protokoll kopieren
  copy_failed = Das Protokoll konnte nicht kopiert werden
  empty = Noch keine Ausgabe.
  errors_only = Nur Fehler
  filter = Protokoll filtern
  follow = Ausgabe verfolgen
  load_failed = Das Protokoll konnte nicht geladen werden
  matches =
    .input {$count :integer}
    .match $count
    one {{{$count} Treffer}}
    * {{{$count} Treffer}}
  output = Ausgabe des Vorgangs
  truncated = Frühere Ausgaben werden hier ausgelassen.
  wrap = Zeilen umbrechen
}

updates {
  available =
    .input {$count :integer}
    .match $count
    one {{{$count} Aktualisierung verfügbar}}
    * {{{$count} Aktualisierungen verfügbar}}
  behind = Rückstand
  check_now = Jetzt prüfen
  checking = Wird geprüft…
  current = Aktuell
  days =
    .input {$count :integer}
    .match $count
    one {{{$count} Tag}}
    * {{{$count} Tage}}
  last_checked = Zuletzt geprüft {$time}
  latest = Neueste
  less_than_a_day = < 1 Tag
  no_check = Noch keine Prüfung auf Aktualisierungen
  no_check_body = Sucht nach neueren Versionen Ihrer Softwarequellen und festgelegten Apps, ohne etwas zu ändern.
  none_found = Keine Aktualisierungen gefunden
  none_found_body = Alles, was geprüft werden konnte, ist aktuell. Beheben Sie die Probleme mit den Quellen oben und prüfen Sie erneut.
  not_checked = Noch nicht geprüft
  pinned = Festgelegte Pakete
  pinned_body = Pakete, die aus den in Ihrer Konfiguration festgelegten Upstream-Versionen gebaut werden.
  release_notes = Versionshinweise
  release_notes_of = Versionshinweise zu {$name}
  revision_link = {$name}, Commit {$rev}, öffnet sich in einem neuen Fenster
  some_failed = Einige Quellen konnten nicht geprüft werden
  source = Quelle
  sources = Softwarequellen
  sources_body = Woher Ihre Software kommt. Aktualisierungen werden gebaut und zur Prüfung angezeigt, bevor sich etwas ändert.
  up_to_date = Alles ist aktuell
  up_to_date_body = Alle Softwarequellen und festgelegten Apps haben ihre neuesten Versionen.
  both = Beides
  pin_description = Lädt die Version herunter und schreibt sie dann in Ihre Konfiguration.
  pin_point_configuration = Ihre Konfiguration wird geändert; Git zeigt genau, was sich geändert hat.
  pin_point_nothing_yet = Auf dem Computer ändert sich noch nichts. Bereiten Sie die Änderungen Ihres Benutzers vor, um die neue Version zu bauen und anzuwenden.
  pin_title = {$name} auf {$version} aktualisieren?
  prepare = Aktualisierungen vorbereiten
  prepare_count =
    .input {$count :integer}
    .match $count
    one {{{$count} Aktualisierung vorbereiten}}
    * {{{$count} Aktualisierungen vorbereiten}}
  select = {$name} auswählen
  select_all = Alle Quellen auswählen
  update = Aktualisieren
  update_name = {$name} aktualisieren
  update_pin = Festgelegte Version aktualisieren
  what_to_prepare = Was vorbereitet wird
}

restore {
  applied_here = Hier angewendet
  clean_up = Aufräumen
  clean_up_ellipsis = Aufräumen…
  cleanup_description = Gibt Speicherplatz frei, indem ältere Versionen gelöscht werden, zu denen Sie danach nicht mehr zurückkehren können.
  cleanup_intro = Entfernt alte Wiederherstellungspunkte und Dateien, die nichts verwendet, um Speicherplatz freizugeben.
  cleanup_keeps =
    .input {$count :integer}
    .match $count
    one {{Behält den neuesten Wiederherstellungspunkt {$scope} sowie den aktuell verwendeten.}}
    * {{Behält die neuesten {$count} Wiederherstellungspunkte {$scope} sowie den aktuell verwendeten.}}
  cleanup_no_going_back = Löscht Dateien, die nichts mehr verwendet. Zu entfernten Wiederherstellungspunkten können Sie nicht zurückkehren.
  cleanup_title = Alte Wiederherstellungspunkte entfernen?
  go_back = Hierhin zurückkehren…
  history = Verlauf
  history_intro = Was sich in der Konfiguration geändert hat, die neueste zuerst.
  in_use = In Verwendung
  intro = Jede Änderung, die Sie anwenden, bewahrt die Version davor auf, damit Sie zurückkehren können.
  keep = Behalten
  keep_fewer = Weniger behalten
  keep_more = Mehr behalten
  list_home = Wiederherstellungspunkte Ihres Benutzers
  list_system = Wiederherstellungspunkte des Systems
  newest = neueste
  no_history = Noch kein Verlauf
  no_history_body = Ist in den Einstellungen „Verlauf der Änderungen führen“ eingeschaltet, wird hier jede angewendete Änderung aufgeführt.
  none = Keine Wiederherstellungspunkte
  none_home = Ihr Benutzer hat noch keine Wiederherstellungspunkte. Sie erscheinen nach der ersten Änderung, die Sie anwenden.
  none_system = Auf diesem Computer wurden keine Wiederherstellungspunkte des Systems gefunden.
  profile = Profil
  running_until_restart = Läuft bis zum Neustart
  running_until_restart_body = Der Computer wurde mit dieser Version gestartet; sie wechselt beim nächsten Neustart.
  what_to_clean_up = Was aufgeräumt werden soll
  cleanup_automatic = In den Einstellungen können alte Wiederherstellungspunkte Ihres Benutzers automatisch entfernt werden.
  cleanup_freeing =
    .input {$count :integer}
    .match $count
    one {{{$count} Wiederherstellungspunkt wird entfernt und gibt etwa {#highlight}{$size}{/highlight} frei{$note}.}}
    * {{{$count} Wiederherstellungspunkte werden entfernt und geben etwa {#highlight}{$size}{/highlight} frei{$note}.}}
  cleanup_frees = Gibt etwa {$size} frei, mehr, wenn weitere ungenutzte Dateien gefunden werden.
  cleanup_measuring =
    .input {$count :integer}
    .match $count
    one {{{$count} Wiederherstellungspunkt wird entfernt. Der dadurch frei werdende Speicherplatz wird gemessen…}}
    * {{{$count} Wiederherstellungspunkte werden entfernt. Der dadurch frei werdende Speicherplatz wird gemessen…}}
  cleanup_removes_home =
    .input {$count :integer}
    .match $count
    one {{Entfernt {$count} Wiederherstellungspunkt Ihres Benutzers.}}
    * {{Entfernt {$count} Wiederherstellungspunkte Ihres Benutzers.}}
  cleanup_removes_none = Es werden keine Wiederherstellungspunkte entfernt; Dateien, die nichts verwendet, werden trotzdem gelöscht.
  cleanup_removes_system =
    .input {$count :integer}
    .match $count
    one {{Entfernt {$count} Wiederherstellungspunkt des Systems und die zugehörigen Einträge im Startmenü; Sie werden nach Ihrem Passwort gefragt.}}
    * {{Entfernt {$count} Wiederherstellungspunkte des Systems und die zugehörigen Einträge im Startmenü; Sie werden nach Ihrem Passwort gefragt.}}
  cleanup_shared = (andere Wiederherstellungspunkte verwenden ihre Dateien weiter)
  could_not_read = Die Wiederherstellungspunkte konnten nicht gelesen werden.
  go_back_builds = Baut diesen Wiederherstellungspunkt erneut und zeigt, was sich gegenüber jetzt ändert.
  go_back_description = Erstellt am {$date}. Das Zurückkehren wird zuerst zur Überprüfung vorbereitet.
  go_back_home_title = Zum Wiederherstellungspunkt {$generation} Ihres Benutzers zurückkehren
  go_back_nothing_yet = Am Computer ändert sich nichts, bis Sie es auf der Seite „Änderungen“ anwenden.
  go_back_system_title = Zum Wiederherstellungspunkt {$generation} des Systems zurückkehren
  scope_user_and_system = Ihres Benutzers und des Systems
}

settings {
  appearance = Erscheinungsbild
  appearance_body = Wie die Arbeitsumgebung oder ein eigenes Farbschema.
  dark = Dunkel
  detected_as = Erkannt als {#highlight}{$host}{/highlight}.
  foreign_host_warning = Änderungen werden jetzt mit der Konfiguration von {$host} gebaut und angewendet. Die Konfiguration eines anderen Computers hier anzuwenden, kann dieses System beschädigen; nutzen Sie das nur, um Builds zu testen.
  home_configuration = Benutzerkonfiguration
  home_profile = Benutzerprofil
  language = Sprache
  language_body = Wie die Arbeitsumgebung oder eine eigene Sprache.
  light = Hell
  nixos_configuration = NixOS-Konfiguration
  privileges = Änderungen werden ohne besondere Rechte vorbereitet und zur Prüfung angezeigt. Nur das Anwenden einer geprüften Systemänderung, das Zurückkehren zu einer früheren Systemversion und das Entfernen von Wiederherstellungspunkten des Systems fragen nach Ihrem Passwort.
  reset = Zurücksetzen
  save_failed = Die Einstellung konnte nicht gespeichert werden
  target_host = Zielrechner
  theme = Farbschema
  this_computer = {$host} (dieser Computer)
  app_details = App-Details von Flathub anzeigen
  app_details_body = Namen, Beschreibungen, Kategorien und Symbole der Apps kommen aus dem öffentlichen Katalog von Flathub, der etwa einmal pro Woche heruntergeladen wird. Die Apps selbst werden weiterhin aus Ihrem nixpkgs installiert.
  backup = Nach jeder Änderung sichern
  backup_body = Der Verlauf wird nach jeder angewendeten Änderung an {$upstream} gesendet.
  backup_no_remote = Der Konfigurationsordner hat noch keine entfernte Kopie, in die gesichert werden kann.
  clean_up = Automatisch aufräumen
  clean_up_body = Einmal pro Woche, während der Computer am Strom hängt und nicht ausgelastet ist, werden ältere Wiederherstellungspunkte Ihrer Apps entfernt und Dateien gelöscht, die nichts mehr verwendet. Die neuesten fünf bleiben. Wiederherstellungspunkte des Systems werden nur entfernt, wenn Sie es wählen.
  detail = Wie viel angezeigt wird
  detail_detailed_body = Jeder Schritt: vorbereiten, dann den vollständigen Vergleich prüfen, dann anwenden.
  detail_simple_body = Ein Knopf wendet Ihre Änderungen an, mit einer kurzen Zusammenfassung vorab, wenn sie einen Blick brauchen.
  detailed = Ausführlich
  history = Verlauf der Änderungen führen
  history_body = Jede angewendete Änderung wird mit einer kurzen Beschreibung gespeichert, damit die Seite „Wiederherstellungspunkte“ zeigt, was sich wann geändert hat. Der Verlauf liegt mit Git im Konfigurationsordner.
  prepare_updates = Aktualisierungen im Hintergrund vorbereiten
  prepare_updates_body = Findet das Symbol in der Kontrollleiste Aktualisierungen, werden sie heruntergeladen und gebaut, während der Computer am Strom hängt und nicht ausgelastet ist. Eine Benachrichtigung meldet, wenn sie bereit sind. Angewendet wird nichts, bevor Sie es entscheiden.
  simple = Einfach
}


rail {
  building_next = Nächste Version wird gebaut
  changes =
    .input {$count :integer}
    .input {$added :integer}
    .input {$removed :integer}
    .match $count
    one {{{$count} Aktualisierung, {$added} neu, {$removed} entfernt}}
    * {{{$count} Aktualisierungen, {$added} neu, {$removed} entfernt}}
  count =
    .input {$count :integer}
    .match $count
    one {{{$count} Wiederherstellungs­punkt}}
    * {{{$count} Wiederherstellungs­punkte}}
  first_build = Erster Build dieses Profils
  in_use_since = In Verwendung seit {$when}
  label = Wiederherstellungspunkte: {$title}
  next_ready = Nächste Version, bereit zum Anwenden
  none = Noch keine Wiederherstellungspunkte
  not_active_until_applied = Erst aktiv, wenn Sie sie anwenden
  point = Wiederherstellungspunkt {$number}, {$when}
  prepare_home = Nächste Version Ihres Benutzers vorbereiten
  prepare_system = Nächste Systemversion vorbereiten
  running = läuft
}

pending {
  apply = Änderungen anwenden
  review_and_apply = Prüfen und anwenden
  clear = Leeren
  count =
    .input {$count :integer}
    .match $count
    one {{{$count} vorgemerkte Änderung}}
    * {{{$count} vorgemerkte Änderungen}}
  hide_lines =
    .input {$count :integer}
    .match $count
    one {{Geänderte Zeilen in {$count} Datei ausblenden}}
    * {{Geänderte Zeilen in {$count} Dateien ausblenden}}
  not_written = Noch nicht geschrieben. „Vorbereiten“ baut sie aus einer Kopie und zeigt, was sie ändern; Ihre Dateien ändern sich erst beim Anwenden.
  nothing_changes = Auf Ihrem Computer ändert sich nichts, bis Sie sie anwenden.
  remove = {$name} entfernen
  show_lines =
    .input {$count :integer}
    .match $count
    one {{Geänderte Zeilen in {$count} Datei anzeigen}}
    * {{Geänderte Zeilen in {$count} Dateien anzeigen}}
}

changes {
  adds = Fügt hinzu:
  after_boot = Die Systemaktualisierung wird nach dem nächsten Neustart verwendet. Ihre Apps werden dann ebenfalls aktualisiert, oder wenden Sie jetzt an, um sie sofort zu aktualisieren.
  apply_now = Jetzt anwenden
  apply_now_title = Diese Änderungen jetzt anwenden?
  apply_on_boot = Beim nächsten Start anwenden
  apply_on_boot_title = Beim nächsten Start anwenden?
  boot_default = Macht das geprüfte System zum Standard-Starteintrag. Das laufende System bleibt bis zum Neustart unverändert.
  checkout_outdated = Ihre Konfiguration hat sich geändert, seit dies vorbereitet wurde, daher kann es nicht mehr angewendet werden. Bereiten Sie erneut vor; dies wird automatisch verworfen.
  compared_to_now = {$size} im Vergleich zu jetzt
  could_not_discard = Die Änderungen konnten nicht verworfen werden
  could_not_hold = Es konnte nicht angehalten werden
  count =
    .input {$count :integer}
    .match $count
    one {{{$count} Änderung}}
    * {{{$count} Änderungen}}
  counts = {$changed :integer} aktualisiert, {$added :integer} neu, {$removed :integer} entfernt
  creates_files =
    .input {$count :integer}
    .input {$files :runic:list}
    .match $count
    one {{Erstellt {$files} und fügt die Datei zu Git hinzu, damit Nix sie lesen kann.}}
    * {{Erstellt {$files} und fügt die Dateien zu Git hinzu, damit Nix sie lesen kann.}}
  deletes = Löscht {$files :runic:list} (von dieser Änderung erstellt).
  discard = Verwerfen
  discarded = Vorbereitete Änderungen verworfen
  draft_moved = Ihre vorgemerkten Änderungen haben sich geändert, seit dies vorbereitet wurde. Beim Anwenden werden die unten gezeigten Änderungen geschrieben; bereiten Sie erneut vor, um die übrigen einzubeziehen.
  edits_checked = Geprüft, indem die Konfiguration von {$host} mit und ohne diese Änderungen ausgewertet wurde. Sie werden beim Anwenden in Ihre Konfiguration geschrieben.
  edits_in_review =
    .input {$count :integer}
    .match $count
    one {{{$count} Änderung in dieser Prüfung}}
    * {{{$count} Änderungen in dieser Prüfung}}
  everything_differs = Alles, was vom laufenden Stand abweicht
  from_version = von {$version}
  hide_details = Details ausblenden
  home_after_restart = Ihre Apps werden nach dem Neustart aktualisiert, sobald der Computer das neue System ausführt.
  home_apps = Apps Ihres Benutzers
  home_disk = Speicherplatzbedarf Ihres Benutzers
  intro = Vorbereitete Builds, die auf Ihre Entscheidung warten. Noch ist nichts davon aktiv.
  kernel_restart = Der Kernel ändert sich; starten Sie danach neu, um ihn zu verwenden.
  lock_changed = Die Quellversionen haben sich geändert, seit diese Aktualisierungen vorbereitet wurden. Verwerfen Sie sie und bereiten Sie sie erneut vor.
  new_kernel = Neuer Kernel {$version}; zur Verwendung ist ein Neustart nötig.
  no_home_to_compare = Es gibt keine aktive Benutzerkonfiguration zum Vergleichen, daher ist alles in diesem Build neu.
  no_system_to_compare = Es gibt keine aktive Systemkonfiguration zum Vergleichen, daher ist alles in diesem Build neu.
  none = Keine vorbereiteten Änderungen
  none_body = Bereiten Sie Änderungen vor, um Ihre Konfiguration zu bauen und mit dem laufenden Stand zu vergleichen.
  nothing_to_compare = Nichts Aktives zum Vergleichen
  option = {$host}, {$scope}, vorbereitet {$time}
  other_host = Für {$host} gebaut, dieser Computer ist aber {$current}.
  packages = Pakete
  packages_home = Paketänderungen Ihres Benutzers
  packages_system = Paketänderungen des Systems
  prepare_all = Ihren Benutzer und das System vorbereiten
  prepare_home = Ihren Benutzer vorbereiten
  prepared_changes = Vorbereitete Änderungen
  prepared_for = Vorbereitet {$time} für {$host}.
  prepared_not_active = Vorbereitet {$time} für {$host}, noch nicht aktiv
  preparing = Änderungen werden vorbereitet…
  preparing_body = Der Build läuft; seine Änderungen erscheinen hier, sobald er fertig ist.
  puts_back =
    .input {$count :integer}
    .input {$files :runic:list}
    .match $count
    one {{Stellt {$files} so wieder her, wie die Datei vor dieser Änderung war.}}
    * {{Stellt {$files} so wieder her, wie die Dateien vor dieser Änderung waren.}}
  removes = Entfernt:
  restore_point_kept = Die aktuelle Version bleibt als Wiederherstellungspunkt erhalten, zu dem Sie zurückkehren können.
  saves_lock = Speichert die geprüften Quellversionen (flake.lock) in Ihrer Konfiguration.
