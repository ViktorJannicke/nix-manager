<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The command and the Polkit helper keep the Bun version's name. -->
    <AssemblyName>nix-manager</AssemblyName>
    <RootNamespace>NixManager</RootNamespace>
    <!-- The dashboard Window (Dashboard/) and its frontend in Frontend/, opened by `nix-manager ui`. -->
    <RunicApplicationFrontendWindowProject>true</RunicApplicationFrontendWindowProject>
    <Version>1.0.0</Version>
    <!-- dotnet restore writes packages.lock.json for the Nix build (W300-032). Nix restores in locked mode for the
         system's runtime identifier alone (dotnet restore with the runtime option), so each runtime has its own lock
         file: a forced evaluation writes the linux-x64 one, and the same restore for linux-arm64 the other (see
         README.md). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifiers)' == 'linux-arm64'">packages.linux-arm64.lock.json</NuGetLockFilePath>
    <!-- The Nix build publishes with NativeAOT (nativeAot in package.nix), whose restore adds the compiler packages:
         a JIT and an AOT lock file per runtime. The tests stay on the JIT lock (NixManager.Tests.csproj). -->
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' == 'linux-arm64'">packages.linux-arm64.aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifiers)' != 'linux-arm64'">packages.aot.lock.json</NuGetLockFilePath>
    <!-- A trim or AOT warning fails the NativeAOT publish: such code may behave differently than under the JIT the
         tests run with. -->
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <!-- The test project has its own sources and build output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);NixManager.Tests/**</DefaultItemExcludes>
    <!-- The policy keeps the Bun version's file name and action ID (nixos-module.nix). -->
    <RunicPolkitPolicyName>org.nixos.nix-manager</RunicPolkitPolicyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Runic.Application.Views.Desktop" Version="0.8.0-preview.4" />
    <PackageReference Include="Runic.CommandLine" Version="0.7.0-preview.2" />
    <PackageReference Include="Runic.CommandLine.Processes" Version="0.7.0-preview.2" />
    <PackageReference Include="Runic.Platform.Linux.Polkit" Version="0.8.0-preview.4" />
    <PackageReference Include="Runic.Translations" Version="0.7.0-preview.3" />
    <PackageReference Include="Runic.Translations.Build" Version="0.7.0-preview.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The dashboard's catalogue, generated as DashboardText for the daemon's own text and the text the backend
         stores in English, which the daemon shows in the dashboard's language (Daemon/TrayText.cs). The stored text is
         found by its English through the importer's base-text index. -->
    <TranslationProject Include="Frontend/translations/runic.json" />
    <EmbeddedResource Include="Frontend/translations/stored/base-text.json" LogicalName="NixManager.Translations.stored.base-text.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NixManager.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- One action, as in the Bun version's policy: one authorization is kept (auth_admin_keep) across the
         privileged steps of an operation, such as activation followed by garbage collection. The verb is the
         Bun version's entry point, and each of its commands is checked by position here; the helper checks
         meaning (PrivilegedHelper). The Nix builder sets RunicApplicationInstallPrefix to $out, whose
         bin/nix-manager is the wrapper pkexec runs; other builds install under /usr, the SDK's default. -->
    <RunicPrivilegedAction Include="org.nixos.nix-manager"
                           Name="Privileged"
                           Program="$(RunicApplicationInstallPrefix)/bin/nix-manager"
                           Verb="--privileged"
                           Description="Rebuild NixOS System"
                           Message="Authentication is required to rebuild the NixOS system configuration."
                           IconName="system-software-update"
                           AllowAny="auth_admin"
                           AllowInactive="auth_admin"
                           AllowActive="auth_admin_keep" />
    <RunicPrivilegedCommand Include="activate-output" Action="org.nixos.nix-manager"
                            Arguments="switch|boot;/nix/store/[a-z0-9]{32}-nixos-system-[A-Za-z0-9._+-]+" />
    <RunicPrivilegedCommand Include="activate-generation" Action="org.nixos.nix-manager" Arguments="[1-9][0-9]{0,9}" />
    <RunicPrivilegedCommand Include="rollback" Action="org.nixos.nix-manager" />
    <RunicPrivilegedCommand Include="gc" Action="org.nixos.nix-manager" Arguments="[1-9][0-9]{0,2}" MinimumArguments="0" />
  </ItemGroup>
</Project>
